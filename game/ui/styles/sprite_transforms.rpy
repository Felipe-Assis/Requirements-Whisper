# sprite_transforms.rpy
# -------------------------------
# TRANSFORMS DE SPRITES
# -------------------------------
# Reusable sprite-position transforms used by `show <char> at <transform>`.

transform sprite_zoom:
    zoom 0.55
    xalign 0.5
    yalign 1.0

transform left_zoom:
    xalign 0.0
    yalign 1.0
    zoom 0.6


transform left_zoom_2:
    xalign 0.2
    yalign 1.0
    zoom 0.6

transform center_zoom:
    xalign 0.5
    yalign 1.0
    zoom 0.6

transform right_zoom:
    xalign 1.0
    yalign 1.0
    zoom 0.6

transform right_zoom2:
    xalign 0.8
    yalign 1.0
    zoom 0.6
